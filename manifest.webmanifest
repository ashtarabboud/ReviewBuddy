{
  "name": "ReviewBuddy",
  "short_name": "ReviewBuddy",
  "description": "Private, on-device sentence-by-sentence review of draft RFP responses.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f4ef",
  "theme_color": "#2f5d8a",
